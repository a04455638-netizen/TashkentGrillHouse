# ====================================================================
# Tashkent Grill House — Environment Configuration Template
# Copy this file to .env.local for local testing or enter in Netlify Dashboard
# ====================================================================

# 1. Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key-here

# 2. Telegram Bot Notifications
# Create a bot via @BotFather on Telegram, obtain the HTTP API token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_your_token
# Chat ID or Group ID where staff receive booking and order alerts
TELEGRAM_CHAT_ID=-1001234567890

# 3. Administrative Console Security
ADMIN_SECRET=tgh-production-admin-passphrase-change-me

# 4. Optional Payment Gateway (Awaiting configuration)
STRIPE_SECRET_KEY=sk_test_awaiting_configuration
STRIPE_WEBHOOK_SECRET=whsec_awaiting_configuration
